{
  "name": "canto-data",
  "version": "1.2.1",
  "description": "Canto journal data model — types, validation, versioning, and format utilities",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./migration": {
      "types": "./dist/migration.d.ts",
      "default": "./dist/migration.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --json --outputFile=coverage/jest-results.json",
    "verify:repo": "make verify",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md,yml,yaml,astro}\"",
    "lint": "eslint .",
    "prepublishOnly": "make verify"
  },
  "keywords": [
    "canto",
    "journal",
    "data-model",
    "validation",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pboueke/canto-data"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "@eslint/js": "10.0.1",
    "@types/jest": "^30.0.0",
    "astro": "^7.3.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "^30.3.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
